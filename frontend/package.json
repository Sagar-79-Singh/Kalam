  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/sync-name.mjs && node scripts/build-artifact-runtime.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "node ../scripts/sync-name.mjs && node scripts/build-artifact-runtime.mjs && tsc -b && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc -b",
    "wails:dev": "cd .. && node scripts/prepare-packaging.mjs && wails dev",
    "wails:build": "cd .. && node scripts/prepare-packaging.mjs && wails build"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.1",
    "typescript": "~5.7.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
